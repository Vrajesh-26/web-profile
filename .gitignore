!.yarn/versions
 
# next.js build output
/.next/
/out/
/build
/dist
.turbo
next-env.d.ts
*.tsbuildinfo
 
# env and secrets: never commit; only .env.example is tracked
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json
 
# deployment
.vercel
 
# testing (vitest, playwright, lighthouse)
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.lighthouseci/
 
# database: local files, dumps, backups, exports (may contain private data)
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.bak
/backups/
*-export*.json
 
# logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.cache/
tmp/
*.tmp
 
# OS
.DS_Store
Thumbs.db
desktop.ini
 
# editors and AI tools (configs here can hold tokens)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.cursor/mcp.json
.claude/settings.local.json
 
.neon
.agents/
tests/ 